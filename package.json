{
  "name": "vuiii",
  "version": "1.0.0-beta.97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greegus/vuiii.git"
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vuiii.js"
    },
    "./style.css": "./dist/vuiii.css"
  },
  "scripts": {
    "dev": "npm run storybook",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --exit-zero-on-changes",
    "docs": "npx jiti scripts/generate-docs.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "npx jiti scripts/generate-vitepress-docs.ts",
    "deploy": "npx jiti scripts/deploy.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/vue3-vite": "^10.3.3",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/language-core": "^3.3.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.57.0",
    "storybook": "^10.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.2.2"
  },
  "peerDependencies": {
    "vue": "^3.5.26",
    "vue-router": "^4.2.5 || ^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
