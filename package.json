{
  "name": "vuiii",
  "version": "1.0.0-beta.98",
  "description": "Simple and customizable Vue 3 component library with TypeScript support, dynamic forms, dialogs, snackbars and composables.",
  "keywords": [
    "component-library",
    "components",
    "composables",
    "design-system",
    "forms",
    "typescript",
    "ui",
    "ui-components",
    "vue",
    "vue3"
  ],
  "homepage": "https://greegus.github.io/vuiii/",
  "bugs": {
    "url": "https://github.com/greegus/vuiii/issues"
  },
  "license": "MIT",
  "author": "Matúš Duchoň <matus.duchon@gmail.com> (https://github.com/greegus)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greegus/vuiii.git"
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vuiii.js"
    },
    "./style.css": "./dist/vuiii.css"
  },
  "scripts": {
    "dev": "npm run storybook",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --exit-zero-on-changes",
    "docs": "npx jiti scripts/generate-docs.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "npx jiti scripts/generate-vitepress-docs.ts",
    "deploy": "npx jiti scripts/deploy.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/language-core": "^3.3.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "storybook": "^10.5.10",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.42",
    "vue-router": "^4.2.5 || ^5.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
